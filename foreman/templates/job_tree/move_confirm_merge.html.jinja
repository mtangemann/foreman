{% import "icons.html.jinja" as icons %}
<div class="w-full max-w-lg rounded-xl bg-white shadow-xl" role="dialog" aria-modal="true" aria-labelledby="merge-title">
    <div class="flex gap-4 p-6">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600">
            {{ icons.icon("warning", "h-5 w-5") }}
        </div>
        <div class="min-w-0 space-y-3 text-sm text-gray-600">
            <h3 id="merge-title" class="text-base font-semibold text-gray-900">Merge folders?</h3>
            <p>
                Relocating <span class="break-all font-mono text-gray-900">{{ source }}</span>
                to <span class="break-all font-mono text-gray-900">{{ destination }}</span>
                would merge into these locations:
            </p>
            <ul class="list-inside list-disc space-y-0.5 font-mono text-xs">
                {% for conflict in conflicts %}
                <li class="break-all">{{ conflict }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <form hx-post="{{ url_for('job_tree.move') }}" class="flex justify-end gap-2 rounded-b-xl bg-gray-50 px-6 py-3">
        <input type="hidden" name="source" value="{{ source }}">
        <input type="hidden" name="destination" value="{{ destination }}">
        <input type="hidden" name="merge_confirmed" value="true">
        <a href="{{ url_for('job_tree.view', path=redirect_to) }}" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-danger">Merge</button>
    </form>
</div>

<script>showModal();</script>
