{% import "macros.html.jinja" as macros %}
{% import "icons.html.jinja" as icons %}
<div class="mx-auto max-w-7xl">
<nav aria-label="Breadcrumb" class="mb-4">
    <ol class="flex min-w-0 flex-wrap items-center gap-x-1 gap-y-1 text-sm text-gray-500">
        <li data-droppable="true" data-path="/" class="rounded">
            <a hx-get="{{ url_for('job_tree.view') }}" hx-target="#contents" hx-replace-url="true" class="flex items-center rounded p-1 hover:cursor-pointer hover:bg-gray-100 hover:text-gray-900" title="All jobs">
                {{ icons.icon("home", "h-4 w-4") }}
            </a>
        </li>
        {% for name, path in breadcrumbs.items() %}
        <li aria-hidden="true">{{ icons.icon("chevron-right", "h-3.5 w-3.5 text-gray-400") }}</li>
        <li data-droppable="true" data-path="{{ path }}" class="min-w-0 rounded">
            <a hx-get="{{ url_for('job_tree.view', path=path) }}" hx-target="#contents" hx-replace-url="true"
                class="block truncate rounded px-1 py-0.5 hover:cursor-pointer hover:bg-gray-100 hover:text-gray-900 {{ 'font-medium text-gray-700' if loop.last }}">{{ name }}</a>
        </li>
        {% endfor %}
    </ol>
</nav>

<div class="card overflow-hidden">
<div class="overflow-x-auto">
<table class="data-table">
    <thead>
        <tr>
            <th class="w-full">Name</th>
            <th>Created</th>
            <th>Status</th>
            <th class="text-right">Actions</th>
        </tr>
    </thead>

    <tbody>
        {% for name, path in directories.items() %}
        <tr draggable="true" data-droppable="true" data-path="{{ path }}" class="group/item">
            <th scope="row" class="font-medium" id="folder-{{ loop.index }}">
                <a hx-get="{{ url_for('job_tree.view', path=path) }}" hx-target="#contents" hx-replace-url="true"
                    class="flex items-center gap-2 text-gray-900 hover:cursor-pointer hover:text-sky-700">
                    {{ icons.icon("folder", "h-5 w-5 shrink-0 text-sky-500") }}<span class="truncate">{{ name }}</span>
                </a>
            </th>
            <td></td>
            <td></td>
            <td class="text-right">
                <button hx-get="{{ url_for('job_tree.move_form', path=path) }}" hx-target="#folder-{{ loop.index }}" hx-swap="innerHTML"
                    class="btn btn-ghost btn-sm" title="Relocate">{{ icons.icon("pencil") }}<span class="hidden xl:inline">Relocate</span></button>
            </td>
        </tr>
        {% endfor %}

        {% for name, entry in jobs.items() %}
        {% set job = entry[0] %}
        <tr draggable="true" class="group/item" data-path="{{ job.virtual_path }}">
            <th scope="row" class="font-medium" id="name-{{ job.id }}">
                <a href="{{ url_for('job.view', id=job.id) }}" class="flex items-center gap-2 text-gray-900 hover:text-sky-700">
                    {{ icons.icon("document", "h-5 w-5 shrink-0 text-gray-400") }}<span class="truncate">{{ name }}</span>
                </a>
            </th>
            <td class="whitespace-nowrap text-gray-600">
                {{ job.timestamp.strftime("%Y-%m-%d") }} <span class="text-gray-400">{{ job.timestamp.strftime("%H:%M") }}</span>
                {% if entry|length > 1 %}
                <a href="{{ url_for('job_tree.view_revisions', path=job.virtual_path) }}" class="link ml-1 text-xs">{{ entry|length }} revisions</a>
                {% endif %}
            </td>
            <td hx-get="{{ url_for('job.status', id=job.id) }}" hx-trigger="every 5s">{{ macros.status(job.status) }}</td>
            <td>
                <div class="flex justify-end gap-1">
                    <button hx-get="{{ url_for('job_tree.move_form', path=job.virtual_path) }}" hx-target="#name-{{ job.id }}" hx-swap="innerHTML"
                        class="btn btn-ghost btn-sm" title="Relocate">{{ icons.icon("pencil") }}<span class="hidden xl:inline">Relocate</span></button>
                    {{ macros.copy_button(job.path, "Path", "btn btn-ghost btn-sm", "hidden xl:inline") }}
                    <a href="/tensorboard/open/{{ job.id }}" target="_blank" class="btn btn-ghost btn-sm" title="Open in TensorBoard">{{ icons.tensorboard_logo() }}<span class="hidden xl:inline">TensorBoard</span></a>
                    {% if job.has_report %}
                    <a href="{{ url_for('job.view', id=job.id, file='/output/report.html') }}" target="_blank" class="btn btn-ghost btn-sm" title="Open report">{{ icons.icon("report") }}<span class="hidden xl:inline">Report</span></a>
                    {% endif %}
                </div>
            </td>
        </tr>
        {% endfor %}

        {% if not directories and not jobs %}
        <tr><td colspan="4" class="py-8 text-center text-gray-500">No jobs here.</td></tr>
        {% endif %}
    </tbody>
</table>
</div>
</div>
</div>
