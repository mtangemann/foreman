{% extends "base.html.jinja" %}

{% import "macros.html.jinja" as macros %}
{% import "icons.html.jinja" as icons %}

{% block title %}Revisions · Foreman{% endblock %}

{% block contents %}
<div class="mx-auto max-w-7xl">
<nav aria-label="Breadcrumb" class="mb-4">
    <ol class="flex min-w-0 flex-wrap items-center gap-x-1 gap-y-1 text-sm text-gray-500">
        <li>
            <a href="{{ url_for('job_tree.view') }}" class="flex items-center rounded p-1 hover:bg-gray-100 hover:text-gray-900" title="All jobs">{{ icons.icon("home", "h-4 w-4") }}</a>
        </li>
        {% for name, path in breadcrumbs.items() %}
        <li aria-hidden="true">{{ icons.icon("chevron-right", "h-3.5 w-3.5 text-gray-400") }}</li>
        <li class="min-w-0">
            <a href="{{ url_for('job_tree.view', path=path) }}" class="block truncate rounded px-1 py-0.5 hover:bg-gray-100 hover:text-gray-900">{{ name }}</a>
        </li>
        {% endfor %}
    </ol>
</nav>

<div class="mb-6 flex items-baseline gap-3">
    <h1 class="page-title">Revisions</h1>
    <span class="text-sm text-gray-500">{{ revisions | length }} total</span>
</div>

<div class="card overflow-hidden">
<div class="overflow-x-auto">
<table class="data-table">
    <thead>
        <tr>
            <th class="w-full">Job</th>
            <th>Created</th>
            <th>Status</th>
            <th class="text-right">Actions</th>
        </tr>
    </thead>

    <tbody>
        {% for job in revisions %}
        <tr>
            <th scope="row" class="font-medium">
                <a href="{{ url_for('job.view', id=job.id) }}" class="link font-mono text-sm">{{ job.id }}</a>
            </th>
            <td class="whitespace-nowrap text-gray-600">
                {{ job.timestamp.strftime("%Y-%m-%d") }} <span class="text-gray-400">{{ job.timestamp.strftime("%H:%M") }}</span>
            </td>
            <td hx-get="{{ url_for('job.status', id=job.id) }}" hx-trigger="every 5s">{{ macros.status(job.status) }}</td>
            <td>
                <div class="flex justify-end gap-1">
                    {{ macros.copy_button(job.path, "Path", "btn btn-ghost btn-sm", "hidden xl:inline") }}
                    <a href="/tensorboard/open/{{ job.id }}" target="_blank" class="btn btn-ghost btn-sm" title="Open in TensorBoard">{{ icons.icon("chart") }}<span class="hidden xl:inline">TensorBoard</span></a>
                </div>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
</div>
</div>
</div>
{% endblock %}
