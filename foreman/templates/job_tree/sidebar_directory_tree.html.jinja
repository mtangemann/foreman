{% import "icons.html.jinja" as icons %}
{% set row = "flex min-w-0 flex-1 items-center gap-1.5 rounded-md px-1.5 py-1 text-sm text-gray-700 hover:cursor-pointer hover:bg-gray-100 hover:text-gray-900" %}
<h2 class="mb-2 px-1.5 text-xs font-semibold uppercase tracking-wide text-gray-500">Folders</h2>
<ul id="directory-tree">
    {%- for name, directory in directory_tree.items() recursive %}
    <li>
        <div class="flex items-center">
            {%- if directory.children %}
            <button type="button" class="rounded p-0.5 text-gray-400 hover:bg-gray-100 hover:text-gray-700" onclick="toggle(this);" aria-expanded="false" aria-label="Expand {{ name }}">
                {{ icons.icon("chevron-right", "h-3.5 w-3.5 transition-transform") }}
            </button>
            {%- else %}
            <span class="w-[1.125rem] shrink-0"></span>
            {%- endif %}
            <a hx-get="{{ url_for('job_tree.view', path=directory.path) }}" hx-target="#contents" hx-replace-url="true" class="{{ row }}" data-droppable="true" data-path="{{ directory.path }}" title="{{ directory.path }}">
                {{ icons.icon("folder", "h-4 w-4 shrink-0 text-sky-500") }}<span class="truncate">{{ name }}</span>
            </a>
        </div>
        {%- if directory.children %}
        <ul class="ml-2.5 hidden border-l border-gray-200 pl-1">
            {{ loop(directory.children.items()) }}
        </ul>
        {%- endif %}
    </li>
    {%- endfor %}
</ul>

<script>
    function toggle(button) {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', !expanded);
        button.firstElementChild.classList.toggle('rotate-90', !expanded);
        button.closest('li').querySelector('ul').classList.toggle('hidden', expanded);
    }
</script>
