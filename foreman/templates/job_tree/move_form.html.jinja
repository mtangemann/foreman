{% import "icons.html.jinja" as icons %}
<form class="flex w-full items-center gap-2" hx-post="{{ url_for('job_tree.move') }}">
    <input type="hidden" name="source" value="{{ path }}">
    <label for="move-form-name" class="sr-only">New location</label>
    <input id="move-form-name" type="text" name="destination" value="{{ path }}" class="input min-w-0 flex-1 font-mono text-xs">
    <button type="submit" class="btn btn-primary btn-sm">{{ icons.icon("check") }}Save</button>
    <button type="button" class="btn btn-secondary btn-sm" hx-get="{{ url_for('job_tree.view', path=path.rsplit('/', 1)[0]) }}" hx-target="#contents">Cancel</button>
    <script>
        document.getElementById('move-form-name').select();
    </script>
</form>
