{# Links to a job's experiment-tracking runs. Set `tracking_job`, and optionally
   `tracking_variant = "sidebar"` for the job sidebar (default: table row buttons). #}
{% import "icons.html.jinja" as icons %}
{% set sidebar = tracking_variant is defined and tracking_variant == "sidebar" %}
{% set links = tracking_links(tracking_job, fresh=sidebar) %}
{% for provider, name in [('mlflow', 'MLflow'), ('wandb', 'W&B')] %}
    {% set runs = links | selectattr('provider', 'equalto', provider) | list %}
    {% set logo = url_for('static', filename='logos/' ~ provider ~ '.svg') %}
    {% if runs | length == 1 %}
        {% if sidebar %}
        <li>
            <a href="{{ runs[0].url }}" target="_blank" rel="noopener noreferrer" title="{{ runs[0].label }}"
                class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900">
                <img src="{{ logo }}" alt="" class="h-5 w-5 shrink-0">{{ name }}
                {{ icons.icon("external", "ml-auto h-3.5 w-3.5 text-gray-400") }}
            </a>
        </li>
        {% else %}
        <a href="{{ runs[0].url }}" target="_blank" rel="noopener noreferrer" title="{{ runs[0].label }}" class="btn btn-ghost btn-sm">
            <img src="{{ logo }}" alt="" class="btn-icon"><span class="hidden xl:inline">{{ name }}</span>
        </a>
        {% endif %}
    {% elif runs %}
        {# A popover renders above everything, so table overflow cannot clip it. #}
        {% set label = name ~ " (" ~ (runs | length) ~ " runs)" %}
        {% set popover_id = "runs-" ~ provider ~ "-" ~ tracking_job.id ~ ("-sidebar" if sidebar else "") %}
        {% if sidebar %}
        <li>
            <button type="button" popovertarget="{{ popover_id }}"
                class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-1.5 text-left text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900">
                <img src="{{ logo }}" alt="" class="h-5 w-5 shrink-0">{{ label }}
                {{ icons.icon("chevron-right", "ml-auto h-3.5 w-3.5 text-gray-400") }}
            </button>
        {% else %}
        <button type="button" popovertarget="{{ popover_id }}" class="btn btn-ghost btn-sm" title="{{ label }}">
            <img src="{{ logo }}" alt="" class="btn-icon"><span class="hidden xl:inline">{{ label }}</span>
            {{ icons.icon("chevron-down", "h-3 w-3") }}
        </button>
        {% endif %}
        <div id="{{ popover_id }}" popover
            class="m-auto w-[min(56rem,calc(100vw-2rem))] rounded-xl border border-gray-200 bg-white p-0 text-left shadow-xl backdrop:bg-gray-900/30">
            <div class="card-header">
                <h3 class="card-title flex items-center gap-2"><img src="{{ logo }}" alt="" class="h-5 w-5">{{ label }}</h3>
                <button type="button" popovertarget="{{ popover_id }}" popovertargetaction="hide" class="btn btn-ghost btn-sm" aria-label="Close">
                    {{ icons.icon("x") }}
                </button>
            </div>
            <ul class="max-h-[60vh] overflow-y-auto p-2">
                {% for run in runs | sort(attribute="label") %}
                <li>
                    <a href="{{ run.url }}" target="_blank" rel="noopener noreferrer"
                        class="flex items-start gap-2 rounded-md px-3 py-2 font-mono text-xs text-gray-700 hover:bg-gray-50 hover:text-sky-700">
                        <span class="min-w-0 flex-1 break-all">{{ run.label.split(": ", 1)[-1] }}</span>
                        {{ icons.icon("external", "mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-400") }}
                    </a>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% if sidebar %}</li>{% endif %}
    {% endif %}
{% endfor %}
