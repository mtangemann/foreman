{# Link to a job's TensorBoard, shown only if it has event files. Set `tensorboard_job`,
   and optionally `tensorboard_variant = "sidebar"` (default: table row button). #}
{% import "icons.html.jinja" as icons %}
{% if tensorboard_available(tensorboard_job) %}
{% if tensorboard_variant is defined and tensorboard_variant == "sidebar" %}
<a href="{{ url_for('open_in_tensorboard', uuid=tensorboard_job.id) }}" target="_blank" rel="noopener noreferrer"
    class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900">
    <img src="{{ url_for('static', filename='logos/tensorboard.svg') }}" alt="" class="h-5 w-5 shrink-0">TensorBoard
    {{ icons.icon("external", "ml-auto h-3.5 w-3.5 text-gray-400") }}
</a>
{% else %}
<a href="{{ url_for('open_in_tensorboard', uuid=tensorboard_job.id) }}" target="_blank" rel="noopener noreferrer"
    class="btn btn-ghost btn-sm" title="Open in TensorBoard">
    <img src="{{ url_for('static', filename='logos/tensorboard.svg') }}" alt="" class="btn-icon"><span class="hidden xl:inline">TensorBoard</span>
</a>
{% endif %}
{% endif %}
