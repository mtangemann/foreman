{% import "icons.html.jinja" as icons %}
<ul class="divide-y divide-gray-100 border-b border-gray-100 bg-gray-50 text-sm">
    {% for host, ok, message in results %}
    <li class="flex items-start gap-2 px-5 py-2.5">
        <span class="mt-0.5 {{ 'text-emerald-600' if ok else 'text-red-600' }}">{{ icons.icon("check" if ok else "x") }}</span>
        <span class="min-w-0">
            <span class="font-mono text-xs font-medium text-gray-900">{{ host }}</span>
            <span class="block whitespace-pre-wrap break-words font-mono text-xs {{ 'text-gray-500' if ok else 'text-red-700' }}">{{ message or ("works" if ok else "failed") }}</span>
        </span>
    </li>
    {% else %}
    <li class="px-5 py-2.5 text-gray-500">No Slurm hosts are configured.</li>
    {% endfor %}
</ul>
