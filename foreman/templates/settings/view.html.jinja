{% extends "base.html.jinja" %}

{% import "icons.html.jinja" as icons %}

{% block title %}Settings · Foreman{% endblock %}

{% set source_styles = {
    "default": "bg-gray-50 text-gray-500 ring-gray-200",
    "config_local.py": "bg-violet-50 text-violet-700 ring-violet-200",
    "foreman.conf": "bg-sky-50 text-sky-700 ring-sky-200",
} %}

{% block contents %}
<div class="mx-auto max-w-4xl space-y-6">
    <div>
        <h1 class="page-title">Settings</h1>
        <p class="mt-1 text-sm text-gray-500">
            Switch off integrations you don't use to make pages faster. Changes apply immediately and are
            stored in <span class="font-mono text-xs text-gray-700">{{ path }}</span>, which takes precedence
            over <span class="font-mono text-xs text-gray-700">config.py</span> and
            <span class="font-mono text-xs text-gray-700">config_local.py</span>.
        </p>
    </div>

    <div hx-get="{{ url_for('settings_page.status') }}" hx-trigger="every 5s" hx-swap="innerHTML">
        {% include "settings/_status.html.jinja" %}
    </div>

    <form id="settings-form" hx-post="{{ url_for('settings_page.save') }}" hx-headers='{"X-Foreman-Request": "settings"}'
        hx-select="#settings-form" hx-target="#settings-form" hx-swap="outerHTML"
        hx-disinherit="*"
        hx-on::before-swap="if ([400, 500].includes(event.detail.xhr.status)) { event.detail.shouldSwap = true; event.detail.isError = false; }"
        class="space-y-6">
        {% if errors %}
        <div role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
            <p class="font-medium">Settings were not saved:</p>
            <ul class="mt-1 list-inside list-disc">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
        {% endif %}

        {% for section, title in sections.items() %}
        <section class="card" aria-labelledby="section-{{ section }}">
            <div class="card-header">
                <h2 id="section-{{ section }}" class="card-title">{{ title }}</h2>
                {% if section == "slurm" %}
                <button type="button" class="btn btn-secondary btn-sm" hx-post="{{ url_for('settings_page.check_slurm_hosts') }}"
                    hx-headers='{"X-Foreman-Request": "settings"}' hx-target="#host-check" hx-swap="innerHTML"
                    hx-indicator="#host-check" title="Run squeue --version on each saved host">
                    {{ icons.icon("check") }}Check hosts
                </button>
                {% endif %}
            </div>
            {% if section == "slurm" %}<div id="host-check" aria-live="polite"></div>{% endif %}
            <div class="divide-y divide-gray-100">
                {% for setting in settings if setting.section == section %}
                {% set value = values[setting.key] %}
                {% set source = sources.get(setting.key, "default") %}
                <div class="flex items-start justify-between gap-6 px-5 py-4">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <label for="{{ setting.key }}" class="text-sm font-medium text-gray-900">{{ setting.label }}</label>
                            <span class="rounded-full px-1.5 py-0.5 text-[10px] font-medium ring-1 ring-inset {{ source_styles[source] }}"
                                title="Where the current value comes from">{{ source }}</span>
                        </div>
                        <p id="{{ setting.key }}-help" class="mt-0.5 text-xs text-gray-500">{{ setting.help }}</p>
                    </div>
                    {% if setting.is_switch %}
                    <label class="relative inline-flex shrink-0 cursor-pointer items-center">
                        <input id="{{ setting.key }}" type="checkbox" name="{{ setting.key }}" value="on" {% if value %}checked{% endif %}
                            aria-describedby="{{ setting.key }}-help" class="peer sr-only">
                        <span class="h-6 w-11 rounded-full bg-gray-200 transition-colors peer-checked:bg-sky-600 peer-focus-visible:ring-2 peer-focus-visible:ring-sky-500 peer-focus-visible:ring-offset-2"></span>
                        <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
                    </label>
                    {% elif setting.kind == "text" %}
                    <input id="{{ setting.key }}" type="text" name="{{ setting.key }}" spellcheck="false"
                        value="{{ value if value is string else value | join(', ') }}"
                        aria-describedby="{{ setting.key }}-help" class="input w-64 shrink-0 font-mono text-xs">
                    {% else %}
                    <input id="{{ setting.key }}" type="number" name="{{ setting.key }}" value="{{ value }}"
                        {% if setting.minimum is not none %}min="{{ setting.minimum }}"{% endif %}
                        {% if setting.maximum is not none %}max="{{ setting.maximum }}"{% endif %}
                        aria-describedby="{{ setting.key }}-help" class="input w-28 shrink-0 text-right tabular-nums">
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </section>
        {% endfor %}

        <div class="flex items-center justify-end gap-3">
            {% if saved %}
            <p role="status" class="flex items-center gap-1 text-sm font-medium text-emerald-700">{{ icons.icon("check") }}Saved</p>
            {% endif %}
            <button type="submit" class="btn btn-primary">Save settings</button>
        </div>
    </form>
</div>
{% endblock %}
