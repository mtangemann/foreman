{% import "macros.html.jinja" as macros %}
<div class="flex flex-col h-full">
{{ macros.file_breadcrumbs(uuid, path) }}

<pre id="file_content" style="width:0;height:0;overflow:hidden;">
{{ content | e }}
</pre>

<div id="container" class="card min-h-0 flex-1 overflow-hidden">
</div>

<script>
    require.config({ paths: { vs: "{{ url_for('static', filename='node_modules/monaco-editor/min/vs') }}" } });

    require(["vs/editor/editor.main"], function () {
        file_content = document.getElementById("file_content").innerText;

        var editor = monaco.editor.create(document.getElementById("container"), {
            value: file_content,
            fontSize: 14,
            language: "{{ language }}",
            readOnly: {% if read_only %}true{% else %}false{% endif %},
            automaticLayout: true,
            minimap: { enabled: false },
            scrollBeyondLastLine: false
        });
    });
</script>
</div>
