{% import "macros.html.jinja" as macros %}

<div class="mb-3 flex items-center gap-3 text-sm">
    <div class="inline-flex rounded-md bg-gray-100 p-0.5" role="group" aria-label="Dependency depth">
        {% for value, label in [(false, "Direct"), (true, "Recursive")] %}
        <button type="button"
           hx-get="{{ url_for('job.dependencies_' ~ direction, id=job.id, recursive=value | lower) }}"
           hx-target="#{{ direction }}-deps" hx-swap="innerHTML"
           aria-pressed="{{ (recursive == value) | lower }}"
           class="rounded px-3 py-1 text-xs font-medium {{ 'bg-white text-gray-900 shadow-sm' if recursive == value else 'text-gray-600 hover:text-gray-900' }}">{{ label }}</button>
        {% endfor %}
    </div>
    <span class="text-gray-500">{{ jobs | length }} job{{ "s" if jobs | length != 1 }}</span>
</div>

{% if jobs %}
{{ macros.jobs_table(jobs, table_id=table_id) }}
{% else %}
<div class="card card-body text-sm text-gray-500">None</div>
{% endif %}
