{% import "icons.html.jinja" as icons %}
{% set item = "flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900 cursor-pointer" %}
<aside id="logo-sidebar" class="hidden w-64 shrink-0 overflow-y-auto border-r border-gray-200 bg-white md:block" aria-label="Job">
    <div class="space-y-6 px-3 py-5">
        <ul class="space-y-0.5">
            {% if tensorboard_available(job) %}
            <li>{% with tensorboard_job=job, tensorboard_variant="sidebar" %}{% include "tensorboard_link.html.jinja" %}{% endwith %}</li>
            {% endif %}
            {% with tracking_job=job, tracking_variant="sidebar" %}{% include "tracking_links.html.jinja" %}{% endwith %}
            {% if job.has_report %}
            <li>
                <a href="{{ url_for('job.view', id=job.id, file='/output/report.html') }}" class="{{ item }}">
                    {{ icons.icon("report", "h-5 w-5 text-gray-400") }}Report
                </a>
            </li>
            {% endif %}
            <li>
                <a hx-get="{{ url_for('job.dependencies', id=job.id) }}" hx-target="#contents" hx-swap="innerHTML" class="{{ item }}">
                    {{ icons.icon("share", "h-5 w-5 text-gray-400") }}Dependencies
                </a>
            </li>
        </ul>

        <div>
            <h2 class="mb-2 px-2.5 text-xs font-semibold uppercase tracking-wide text-gray-500">Files</h2>
            <section id="files" hx-trigger="load" hx-get="{{ url_for('job.view_directory', id=job.id) }}"></section>
        </div>
    </div>
</aside>
